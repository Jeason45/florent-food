# Database
DATABASE_URL=postgresql://user:password@localhost:5432/florent_food?schema=public

# Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email Configuration (Gmail SMTP)
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-app-password-here

# JWT Secret (IMPORTANT: Generate a strong random secret)
# Generate with: openssl rand -base64 32
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_SECRET_KEY

# Cloudinary (Image hosting)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your-upload-preset
NEXT_PUBLIC_CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Google Analytics (Optional)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GA_PROPERTY_ID=123456789

# Google Analytics Data API Credentials (Base64)
# Encode with: cat google-analytics-credentials.json | base64 | tr -d '\n'
GOOGLE_APPLICATION_CREDENTIALS_BASE64=your-base64-encoded-credentials
